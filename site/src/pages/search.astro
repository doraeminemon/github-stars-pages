---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Search">
  <h1>Search</h1>
  <p class="subtitle" id="search-status">
    Type to search instantly. Semantic search loads after your first query.
  </p>
  <input
    id="search-input"
    class="search-box"
    type="text"
    placeholder="e.g. tools for parsing structured logs"
    autocomplete="off"
    autofocus
  />
  <div id="results" class="grid" style="margin-top: 24px;"></div>

  <script>
    import { fuseRRF, getDoc, lexicalSearch, loadLexicalIndex, semanticSearch } from '../lib/search';
    import { url } from '../lib/url';

    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.getElementById('results') as HTMLDivElement;
    const status = document.getElementById('search-status') as HTMLParagraphElement;

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    function renderResults(ids: string[]) {
      results.innerHTML = ids
        .map((id) => {
          const doc = getDoc(id);
          if (!doc) return '';
          const [owner, name] = doc.full_name.split('/');
          const tags = doc.tags
            .slice(0, 6)
            .map((t) => `<a class="chip" href="${url(`/tag/${t}`)}">${escapeHtml(t)}</a>`)
            .join('');
          return `
            <div class="card">
              <h3><a href="${url(`/repo/${owner}/${name}`)}">${escapeHtml(doc.full_name)}</a></h3>
              ${doc.description ? `<p class="desc">${escapeHtml(doc.description)}</p>` : ''}
              <div class="chips">${tags}</div>
            </div>
          `;
        })
        .join('');
    }

    let debounceTimer: ReturnType<typeof setTimeout>;
    let requestId = 0;

    async function runSearch(query: string) {
      const myRequest = ++requestId;
      if (!query.trim()) {
        results.innerHTML = '';
        status.textContent = 'Type to search instantly. Semantic search loads after your first query.';
        return;
      }

      const ms = await loadLexicalIndex();
      if (myRequest !== requestId) return;
      const lexical = lexicalSearch(ms, query);
      renderResults(lexical.map((r) => r.id));
      status.textContent = `${lexical.length} instant matches · loading semantic ranking…`;

      try {
        const semantic = await semanticSearch(query);
        if (myRequest !== requestId) return;
        const fused = fuseRRF([lexical, semantic]);
        renderResults(fused.map((r) => r.id));
        status.textContent = `${fused.length} results, ranked by keyword + meaning`;
      } catch (err) {
        console.error('semantic search failed', err);
        if (myRequest !== requestId) return;
        status.textContent = `${lexical.length} instant matches (semantic search unavailable)`;
      }
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = input.value;
      debounceTimer = setTimeout(() => runSearch(query), 120);
    });

    // Warm the lexical index immediately so the first keystroke is instant.
    loadLexicalIndex();
  </script>
</Layout>
